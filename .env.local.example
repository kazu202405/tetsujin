# ============================================================
# Supabase 接続情報のテンプレート
# ============================================================
# このファイルを .env.local にコピーして値を埋める。
# .env.local は .gitignore 済み＝絶対にコミットしないこと。
#
# 値の取得場所（Supabaseダッシュボード）:
#   Project Settings → Data API  … Project URL
#   Project Settings → API Keys  … publishable(anon) キー / secret(service_role) キー
# ============================================================

# --- ブラウザに露出してよい公開情報 -------------------------
# ログイン画面など、ブラウザ側のSupabase Authが使う。
# publishable(anon) キーは公開前提の設計で、RLSによって守られる。
# （members は「本人の行」と「運営」以外読めないポリシーを policies.sql で定義済み）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- サーバー側でしか使わない秘密情報 -----------------------
# 取込スクリプトと /api/health/db、管理者作成スクリプトが使う。
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# 🔴 service_role(secret) キーは RLS を無視して全データを読み書きできる管理者キー。
#    サーバー側（route handler / scripts）専用。
#    NEXT_PUBLIC_ を付けるとブラウザに露出し会員名簿が漏洩するため絶対に付けないこと。
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Web Push（端末プッシュ通知）
# ============================================================
# 鍵の作り方:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# 公開鍵はブラウザが購読するときに使うので NEXT_PUBLIC_ で良い。
# 秘密鍵は送信時の署名に使うため、絶対に NEXT_PUBLIC_ を付けないこと。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 送信元の連絡先（配信事業者からの問い合わせ先。mailto: 形式）
VAPID_SUBJECT=mailto:tetsujin.community@gmail.com

# 🔴 /api/push/dispatch を守る共有シークレット。
#    Supabase の Database Webhook が x-dispatch-secret ヘッダで送る。
#    これが無いと誰でも任意の会員へ通知を送れてしまうため必須。
#    作り方: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PUSH_DISPATCH_SECRET=

# 🔴 週次ダイジェスト（/api/cron/weekly-digest）を守る合言葉。
#    Vercel Cron が Authorization: Bearer <値> で送る。
#    これが無いと誰でも全員へダイジェストを投げられるため必須。
CRON_SECRET=

# ------------------------------------------------------------
# Stripe（会費の決済）
# ------------------------------------------------------------
# 🔴 値そのものはここに書かない。変数名だけ。
#    鍵が未設定の間、決済まわりは「準備中」を表示して止まる。
#
# 秘密鍵。サーバー側だけで使う（NEXT_PUBLIC_ を付けてはいけない）。
# テストは sk_test_... 本番は sk_live_...
STRIPE_SECRET_KEY=

# Webhook の署名シークレット（whsec_...）。
# 🔴 これが無いと署名を検証できず、URLを知った誰でも
#    「支払い済み」を送り込めてしまうため必須。
# Stripe ダッシュボード → 開発者 → Webhook でエンドポイントを作ると発行される。
#   宛先: https://<本番URL>/api/stripe/webhook
#   送るイベント: checkout.session.completed /
#                customer.subscription.created|updated|deleted /
#                invoice.payment_failed
STRIPE_WEBHOOK_SECRET=

# Checkout から戻ってくる先。未設定なら Vercel の本番URLを使う。
NEXT_PUBLIC_APP_URL=

# 価格ID（price_...）は環境変数ではなくDBに持つ。
# 料金が月額3種類＋年額の4本立てで、会員ごとに違うため。
#   → billing_plans テーブルの stripe_price_id に入れる（管理画面から設定）
